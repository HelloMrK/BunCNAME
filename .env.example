# PocketGate environment — copy to .env and fill in. NEVER commit real .env.

# Shared secret between PocketBase hook and the sync service.
# When set, POST /sync requires header: X-Sync-Token: <same value>
SYNC_TOKEN=change-me-to-a-long-random-string

# Record types managed (comma separated). Anything not listed is left untouched.
# CNAME,A enables both CNAME and A records.
MANAGED_TYPES=CNAME

# Cloudflare (recommended public provider)
# Token needs: Zone - Read, DNS - Edit (scoped to your zone for safety)
CLOUDFLARE_API_TOKEN=

# AdGuard Home (internal provider)
ADGUARD_HOME_URL=http://adguardhome:3000
ADGUARD_HOME_USERNAME=admin
ADGUARD_HOME_PASSWORD=

# Porkbun (optional, alternative public provider)
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
